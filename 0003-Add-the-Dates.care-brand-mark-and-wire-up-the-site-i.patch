diff --git a/index.html b/index.html
index 802f314..d976ef6 100644
--- a/index.html
+++ b/index.html
@@ -38,6 +38,19 @@
     <link rel="alternate" hreflang="en" href="https://dates.care/" />
     <link rel="alternate" hreflang="x-default" href="https://dates.care/" />
 
+    <!-- Icons. The site shipped with none, so every browser tab showed a blank
+         page glyph and an installed shortcut had nothing to display. Two
+         artworks, deliberately: the full mark carries the two rings and the
+         D/C, which need room, while the favicon drops to the heart alone
+         because below about 32px the rings close up and the letters vanish.
+         Same tile, same heart - one brand at two densities. -->
+    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
+    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
+    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
+    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
+    <link rel="manifest" href="/site.webmanifest" />
+    <meta name="theme-color" content="#EC4899" />
+
     <!-- Preconnect for Performance -->
     <!-- Supabase is the origin every screen depends on, and it was not
          preconnected: the browser only began DNS + TLS for it after the JS
@@ -126,7 +139,7 @@
       "@type": "Organization",
       "name": "Dates.care",
       "url": "https://dates.care/",
-      "logo": "https://dates.care/logo.png",
+      "logo": "https://dates.care/brand/logo-512.png",
       "sameAs": [
         "https://twitter.com/datescare",
         "https://facebook.com/datescare",
diff --git a/public/apple-touch-icon.png b/public/apple-touch-icon.png
